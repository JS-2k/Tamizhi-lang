அச்சிடு("வணக்கம் உலகம்!");
எண் அ = 10;
எண் ஆ = 20;

அச்சிடு(அ + ஆ);

என்றால் (அ < ஆ) {
    அச்சிடு("அ சிறியது");
} இல்லையெனில் {
    அச்சிடு("அ பெரியது அல்லது சமம்");
}

என்றால் (அ == 10) {
    அச்சிடு("அ சரியான மதிப்பு");
}

என்றால் (அ != ஆ )
{
    அச்சிடு("சரி இல்ல ");
} இல்லையெனில் {
    அச்சிடு("ஓகே");
} 
